{
  "meta": {
    "name": "supply-chain-agent-eval-set",
    "version": "1.0.0",
    "description": "Agent 评估集：期望输出来自 risk_tools.calculate_risk_score 的确定性公式（delay×5 + price_deviation×3 + (5-rating)×4 + incidents×10，封顶 100；分级线 low≤30 < medium≤50 < high≤70 < critical）。覆盖四档风险等级、边界值、缺失字段鲁棒性场景。",
    "scoring_formula": "score = min(100, delay_days*5 + price_deviation*3 + (5-supplier_rating)*4 + historical_incidents*10)"
  },
  "cases": [
    {
      "case_id": "eval_001",
      "description": "正常订单-低风险场景",
      "input": {
        "order_id": "ORD-E001",
        "supplier_id": "SUP-088",
        "amount": 50000,
        "delay_days": 0,
        "price_deviation": 0,
        "supplier_rating": 4.5,
        "historical_incidents": 0
      },
      "expected_output": {
        "risk_level": "low",
        "risk_score_range": [
          0,
          30
        ],
        "must_have_tags": [],
        "must_not_have_tags": [
          "delay",
          "price_anomaly",
          "supplier_risk"
        ]
      }
    },
    {
      "case_id": "eval_002",
