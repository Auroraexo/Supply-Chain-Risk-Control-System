# =============================================================================
# 供应链智能决策系统 - 环境变量模板
# 复制此文件为 .env 并填入真实值
# 禁止将 .env 提交到 Git
# =============================================================================

# 应用配置
ENVIRONMENT=development
APP_NAME=supply-chain-risk-control
DEBUG=true
LOG_LEVEL=INFO

# 服务端口
HOST=0.0.0.0
PORT=8000

# 数据库 (MySQL 8.0)
DATABASE_URL=mysql+asyncmy://root:password@localhost:3306/supply_chain_risk

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT 认证
JWT_SECRET_KEY=change-me-to-a-random-secret-key-at-least-64-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# RabbitMQ (可选)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# CORS 允许的域名 (逗号分隔)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# LLM Provider 配置
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4000
LLM_TIMEOUT=30

# LLM Mock 模式 (测试用，不调用真实 API)
LLM_MOCK_MODE=false

# LangSmith 可观测性 (可选)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=supply-chain-risk

# 安全
RATE_LIMIT_PER_MINUTE=60
REQUEST_BODY_MAX_SIZE_MB=10

# 企业微信通知 (可选)
WECOM_WEBHOOK_URL=

# 邮件通知 (可选)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL=